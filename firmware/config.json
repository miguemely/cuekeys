{
  "version": 1,
  "device": {
    "hardware": "keybow2040",
    "brightness": 0.5,
    "hold_time_ms": 500,
    "debounce_ms": 15,
    "midi_channel": 1,
    "keyboard_layout": "us",
    "host_os": "auto",
    "pressed_color": "#ffffff"
  },
  "layers": [
    {
      "name": "Editing",
      "color": "#3050ff",
      "mode": "local",
      "keys": {
        "0": {
          "label": "Next layer\n(hold: home)",
          "color": "#ffffff",
          "press": [
            {
              "type": "layer",
              "op": "next"
            }
          ],
          "hold": [
            {
              "type": "layer",
              "op": "goto",
              "layer": 0
            }
          ]
        },
        "1": {
          "label": "Vol -",
          "color": "#ff8800",
          "press": [
            {
              "type": "consumer",
              "code": "VOLUME_DECREMENT"
            }
          ]
        },
        "2": {
          "label": "Save",
          "color": "#20c050",
          "press": [
            {
              "type": "keys",
              "keys": [
                "PRIMARY",
                "S"
              ],
              "mode": "tap"
            }
          ]
        },
        "3": {
          "label": "Copy",
          "press": [
            {
              "type": "keys",
              "keys": [
                "PRIMARY",
                "C"
              ],
              "mode": "tap"
            }
          ]
        },
        "5": {
          "label": "Mute",
          "color": "#ff8800",
          "press": [
            {
              "type": "consumer",
              "code": "MUTE"
            }
          ]
        },
        "6": {
          "label": "Hello",
          "press": [
            {
              "type": "text",
              "text": "Hello from PMK!"
            }
          ]
        },
        "7": {
          "label": "Paste",
          "press": [
            {
              "type": "keys",
              "keys": [
                "PRIMARY",
                "V"
              ],
              "mode": "tap"
            }
          ]
        },
        "9": {
          "label": "Vol +",
          "color": "#ff8800",
          "press": [
            {
              "type": "consumer",
              "code": "VOLUME_INCREMENT"
            }
          ]
        },
        "10": {
          "label": "Select all\n+ copy",
          "press": [
            {
              "type": "keys",
              "keys": [
                "PRIMARY",
                "A"
              ],
              "mode": "tap"
            },
            {
              "type": "delay",
              "ms": 50
            },
            {
              "type": "keys",
              "keys": [
                "PRIMARY",
                "C"
              ],
              "mode": "tap"
            }
          ]
        },
        "11": {
          "label": "Undo",
          "press": [
            {
              "type": "keys",
              "keys": [
                "PRIMARY",
                "Z"
              ],
              "mode": "tap"
            }
          ]
        },
        "13": {
          "label": "Play",
          "color": "#ff8800",
          "press": [
            {
              "type": "consumer",
              "code": "PLAY_PAUSE"
            }
          ]
        },
        "14": {
          "label": "Shift\n(held)",
          "press": [
            {
              "type": "keys",
              "keys": [
                "SHIFT"
              ],
              "mode": "hold"
            }
          ]
        },
        "15": {
          "label": "Redo",
          "press": [
            {
              "type": "keys",
              "keys": [
                "PRIMARY",
                "SHIFT",
                "Z"
              ],
              "mode": "tap"
            }
          ]
        }
      }
    },
    {
      "name": "grandMA3",
      "color": "#ffb000",
      "mode": "local",
      "keys": {
        "0": {
          "label": "Next layer\n(hold: home)",
          "color": "#ffffff",
          "press": [
            {
              "type": "layer",
              "op": "next"
            }
          ],
          "hold": [
            {
              "type": "layer",
              "op": "goto",
              "layer": 0
            }
          ]
        },
        "2": {
          "label": "Clear",
          "press": [
            {
              "type": "ma",
              "console": "ma3",
              "command": "Clear"
            }
          ]
        },
        "3": {
          "label": "Go+ 201",
          "color": "#20c050",
          "press": [
            {
              "type": "ma",
              "console": "ma3",
              "command": "Go+ Executor 201"
            }
          ]
        },
        "6": {
          "label": "MSC Go\ncue 1",
          "color": "#00c0ff",
          "press": [
            {
              "type": "msc",
              "command": "go",
              "cue": "1",
              "device_id": 127,
              "command_format": "all"
            }
          ]
        },
        "7": {
          "label": "Go- 201",
          "press": [
            {
              "type": "ma",
              "console": "ma3",
              "command": "Go- Executor 201"
            }
          ]
        },
        "10": {
          "label": "MSC fire\nmacro 1",
          "color": "#00c0ff",
          "press": [
            {
              "type": "msc",
              "command": "fire",
              "macro": 1,
              "device_id": 127,
              "command_format": "all"
            }
          ]
        },
        "11": {
          "label": "Pause 201",
          "color": "#ffff00",
          "press": [
            {
              "type": "ma",
              "console": "ma3",
              "command": "Pause Executor 201"
            }
          ]
        },
        "14": {
          "label": "Fader 201\n100%",
          "color": "#c000ff",
          "press": [
            {
              "type": "osc",
              "address": "/gma3/Page1/Fader201",
              "args": [
                100
              ],
              "release_args": [
                0
              ],
              "target": "default"
            }
          ]
        },
        "15": {
          "label": "Off 201",
          "color": "#ff2020",
          "press": [
            {
              "type": "ma",
              "console": "ma3",
              "command": "Off Executor 201"
            }
          ]
        }
      }
    },
